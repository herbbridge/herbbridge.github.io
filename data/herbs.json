    {
      "id": "danshen",
      "name_en": "Danshen",
      "name_zh": "丹參",
      "latin": "Salvia miltiorrhiza",
      "used_for_en": "blood circulation and heart health",
      "used_for_zh": "血液循環同心臟健康",
      "aliases": [
        "dan shen",
        "daan sam",
        "daan1 sam1",
        "丹参",
        "red sage",
        "Chinese sage"
      ],
      "zh_reviewed": false,
      "uses": {
        "line_en": "Used in China for angina (chest pain from heart disease). A 2023 review of 29 small trials found danshen pills eased angina symptoms more than nitrates, but the authors rated the evidence very low to low quality.",
        "line_zh": "喺中國用嚟治心絞痛（心臟病引致嘅胸口痛）。2023年一份綜合29個細規模研究嘅分析發現，丹參滴丸紓緩心絞痛症狀比硝酸鹽類藥好，但作者評定證據質素為極低至低。",
        "full_en": "A 2015 overview judged the evidence poor, and benefits on heart attacks or deaths unproved.",
        "full_zh": "2015年一份綜述評定證據質素差，對心臟病發或者死亡嘅好處亦未有證實。",
        "sources": [
          {
            "label": "Zhang et al. Front Cardiovasc Med 2023",
            "url": "https://doi.org/10.3389/fcvm.2023.1168730"
          },
          {
            "label": "Luo et al. Am J Chin Med 2015",
            "url": "https://doi.org/10.1142/S0192415X15500020"
          }
        ],
        "zh_reviewed": false
      }
