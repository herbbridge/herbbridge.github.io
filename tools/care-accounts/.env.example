# Development only. Copy to .env.local (ignored). Use your own development project.
HERBBRIDGE_ENV=development
SUPABASE_URL=https://YOUR_DEVELOPMENT_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Must match the project part of SUPABASE_URL; prevents accidental cross-project checks.
SUPABASE_EXPECTED_PROJECT_REF=YOUR_DEVELOPMENT_PROJECT
# Never put a service-role/secret key, database password or access token here.
